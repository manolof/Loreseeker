# BigWigs packager configuration (used by CurseForge/Wago/GitHub Actions to build releases).
package-as: Loreseeker

# Libraries are committed in Libs/ (no externals), so packaging works offline too.

ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - README.md
  - CURSEFORGE.md
  - media

enable-nolib-creation: no
